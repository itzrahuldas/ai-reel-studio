# AI Reel Studio public HTTPS staging environment template
# Copy to .env.public-staging on the staging host. Never commit real secret values.
# Replace every <...> placeholder on the server only.

# Compose
# Keep this as .env.public-staging after copying this template to the real host env file.
STAGING_ENV_FILE=.env.public-staging

# App
APP_ENV=staging
APP_VERSION=0.1.0
DEBUG=false
FRONTEND_URL=https://app-staging.<your-domain>
API_PUBLIC_BASE_URL=https://api-staging.<your-domain>
NEXT_PUBLIC_API_URL=https://api-staging.<your-domain>
ALLOWED_ORIGINS=["https://app-staging.<your-domain>"]

# Database
POSTGRES_USER=<staging-postgres-user>
POSTGRES_PASSWORD=<staging-postgres-password>
POSTGRES_DB=<staging-postgres-db>
DATABASE_URL=postgresql+asyncpg://<staging-postgres-user>:<staging-postgres-password>@postgres:5432/<staging-postgres-db>

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth / Security
SECRET_KEY=<generate-strong-staging-secret-key-on-server>
TOKEN_ENCRYPTION_KEY=<generate-64-hex-character-token-encryption-key-on-server>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage / Media
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=https://api-staging.<your-domain>/static
LOCAL_STORAGE_PATH=/var/lib/ai-reel-studio/media
S3_ENDPOINT_URL=<s3-compatible-endpoint-url-if-used>
S3_BUCKET=<s3-compatible-bucket-if-used>
S3_ACCESS_KEY_ID=<s3-access-key-id-if-used>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key-if-used>
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=20971520

# Runtime modes
GENERATION_MODE=async
RENDER_MODE=async
PUBLISH_MODE=async
GENERATION_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
PUBLISH_WORKER_CONCURRENCY=2

# Instagram / Meta
INSTAGRAM_INTEGRATION_MODE=live
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>
META_REDIRECT_URI=https://api-staging.<your-domain>/api/v1/integrations/instagram/callback
META_GRAPH_API_VERSION=v21.0

# Stripe Billing
STRIPE_MODE=mock
STRIPE_SECRET_KEY=<stripe-secret-key-if-live-testing>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret-if-live-testing>
STRIPE_CREATOR_PRICE_ID=<stripe-creator-price-id-if-live-testing>
STRIPE_PRO_PRICE_ID=<stripe-pro-price-id-if-live-testing>
STRIPE_CUSTOMER_PORTAL_RETURN_URL=https://app-staging.<your-domain>/dashboard/billing
STRIPE_CHECKOUT_SUCCESS_URL=https://app-staging.<your-domain>/dashboard/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://app-staging.<your-domain>/dashboard/billing/cancel
STRIPE_API_VERSION=<stripe-api-version-if-pinned>

# AI Providers
AI_PROVIDER=mock
AI_API_KEY=<ai-api-key-if-live-testing>
AI_MODEL=<ai-model-if-live-testing>
IMAGE_ANALYSIS_PROVIDER=mock
IMAGE_ANALYSIS_MODEL=<image-analysis-model-if-live-testing>
TTS_PROVIDER=mock
TTS_MODEL=<tts-model-if-live-testing>
TTS_VOICE=<tts-voice-if-live-testing>
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_GENERATION_TEMPERATURE=0.7

# Future video provider placeholders
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=<video-provider-api-key-if-used>
TTS_PROVIDER_API_KEY=<tts-provider-api-key-if-used>

# Rate limits
RATE_LIMIT_GENERATION_PER_HOUR=10
RATE_LIMIT_PUBLISH_PER_DAY=25
