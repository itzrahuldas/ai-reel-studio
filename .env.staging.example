# AI Reel Studio staging environment template
# Copy to .env.staging on the staging host. Never commit real secret values.

# App
APP_ENV=staging
APP_VERSION=0.1.0
DEBUG=false

# Database
# For Docker Compose self-hosted staging, keep DATABASE_URL pointed at postgres.
# For managed Postgres, replace DATABASE_URL with the provider's asyncpg URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_reel_studio_staging
DATABASE_URL=postgresql+asyncpg://postgres:<password>@postgres:5432/ai_reel_studio_staging

# Redis / Celery
# For managed Redis, set all three URLs to the provider URLs.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Public URLs
FRONTEND_URL=
API_PUBLIC_BASE_URL=
NEXT_PUBLIC_API_URL=
ALLOWED_ORIGINS=

# Auth / Security
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage / Media
# Prefer s3-compatible object storage for staging. Use local only with persistent disk.
STORAGE_PROVIDER=
STORAGE_PUBLIC_BASE_URL=
LOCAL_STORAGE_PATH=/var/lib/ai-reel-studio/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=20971520

# Runtime modes
GENERATION_MODE=async
RENDER_MODE=async
PUBLISH_MODE=async

# Instagram / Meta
INSTAGRAM_INTEGRATION_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v19.0

# Stripe Billing
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_API_VERSION=

# AI Providers
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
IMAGE_ANALYSIS_PROVIDER=mock
IMAGE_ANALYSIS_MODEL=
TTS_PROVIDER=mock
TTS_MODEL=
TTS_VOICE=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_GENERATION_TEMPERATURE=0.7

# Rate limits
RATE_LIMIT_GENERATION_PER_HOUR=10
RATE_LIMIT_PUBLISH_PER_DAY=25
