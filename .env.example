# -- Application --------------------------------------------------------------
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -- Database & Cache --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_reel_studio
REDIS_URL=redis://localhost:6379/0

# -- Security -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_string_in_production
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_string_in_production

# -- Storage ------------------------------------------------------------------
# Use 'local' for dev without MinIO, 's3' for production/MinIO
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ai-reel-studio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# -- AI Providers -------------------------------------------------------------
# Options: mock, openai
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
IMAGE_ANALYSIS_PROVIDER=mock
IMAGE_ANALYSIS_MODEL=
TTS_PROVIDER=mock
TTS_MODEL=
TTS_VOICE=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_GENERATION_TEMPERATURE=0.7

# Options: runway, luma, stability, none, mock
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=your_video_api_key

TTS_PROVIDER_API_KEY=your_tts_api_key

# -- Meta / Instagram ---------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback
META_GRAPH_API_VERSION=v21.0
INSTAGRAM_INTEGRATION_MODE=mock

# -- Stripe Billing -----------------------------------------------------------
# Options: mock, live. Mock is local-development only.
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_API_VERSION=

# -- Generation Mode ----------------------------------------------------------
# 'async' = use Celery + Redis (requires docker-compose up)
# 'sync'  = run mock pipeline inline without Celery (for local dev without Docker)
GENERATION_MODE=sync
RENDER_MODE=async
PUBLISH_MODE=async

# -- File Upload --------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520

# -- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
