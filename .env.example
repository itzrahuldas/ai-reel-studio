# -- Application --------------------------------------------------------------
APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# -- Database & Cache --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_reel_studio
REDIS_URL=redis://localhost:6379/0

# -- Security -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_string_in_production
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_string_in_production

# -- Storage ------------------------------------------------------------------
# Use 'local' for dev without MinIO, 's3' for production/MinIO
STORAGE_PROVIDER=local
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ai-reel-studio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# -- AI Providers -------------------------------------------------------------
# Options: openai, gemini, anthropic, mock
AI_PROVIDER=mock
AI_API_KEY=your_llm_api_key

# Options: runway, luma, stability, none, mock
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=your_video_api_key

# Options: elevenlabs, openai, google, mock
TTS_PROVIDER=mock
TTS_PROVIDER_API_KEY=your_tts_api_key

# -- Meta / Instagram ---------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/v1/social-accounts/instagram/callback
META_GRAPH_API_VERSION=v21.0
